{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warhammer Companion",
  "version": "0.1.0",
  "identifier": "com.warhammer.companion",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Warhammer Companion",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "theme": "Dark",
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8787 http://localhost:8787 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../server/dist-bundle": "server"
    }
  }
}